# MPC 주요 튜닝 상수 — 코드에 박혀 있던 값들을 한곳에 모은 파일 (2026-07-29)
# ===========================================================================
# 여기 없는 값(R_car_live, R_safe_live, q_*_scale_live, corridor_hard 존,
# track_source 등)은 ROS 파라미터라 config/ddrx_unified_params.yaml 에 있고
# 주행 중에도 `ros2 param set` 으로 바뀐다. 이 파일은 그렇게 못 바꾸던,
# 코드에 하드코딩돼 있던 값들을 담는다.
#
# ⚠ 반영 방법이 섹션마다 다르다:
#     slack         → mpc_node 재시작만 (런타임 cost_set 경로)
#     cost_weights  → acados 재생성 필요. 값이 바뀌면 codegen 해시가 달라져
#                     자동 재빌드된다(수 분 소요).
#     obstacle      → 위와 같이 재생성 필요 (심볼릭 모델에 들어감).
#
# 파일이 없거나 키가 빠지면 해당 항목만 코드 기본값으로 조용히 폴백한다 —
# 튜닝 파일 하나 때문에 제어 노드가 못 뜨는 일은 없어야 한다.


# ── 슬랙(제약 위반) 벌점 — acados soft-constraint 가중치 ───────────────────
# ===========================================================================
# MPC 의 h-제약은 전부 "소프트"다. 슬랙 s ≥ 0 로 위반을 허용하고 그 대가를
# 비용으로 문다:
#
#     비용 = zl·s + Zl·s²        (되미는 힘 = zl + 2·Zl·s)
#
# 즉 zl/Zl 이 작으면 솔버는 "위반하고 벌점 내는 쪽"이 이득이라고 판단한다.
# 제약이 지켜지느냐 마느냐는 사실상 이 두 숫자가 정한다.
#
# zu/Zu 는 상한(uh) 쪽 슬랙이다. corridor·obstacle 행은 uh=1e15 (한쪽만 제약)
# 이라 zu/Zu 가 쓰이지 않는다 — 값이 있어도 무해하지만 바꿔도 효과 없다.
#
# 행 순서(acados h 벡터)와 의미:
#   obstacle   idx0  h_obs      1번 장애물 keepout
#   corridor   idx1,2 corr_top / corr_bot   좌·우 벽 (같은 값 사용)
#   a_lat      idx3   횡가속 한계
#   ellipse    idx4   마찰원
#   obstacle2  idx5   2번 장애물
#   obstacle3  idx6   3번 장애물
#
# ---------------------------------------------------------------------------
# 이력
#   ~2026-06-02  corridor 20/15. 6배 강화 시도했다가 랩당 5.1접촉으로 악화되어
#                원복(강한 corridor push 가 반대편 벽 클립 유발).
#   2026-07-29   corridor 20/15 → 200/120 (장애물 행과 동급) 재시도.
#                근거: 존 없는 bag 15_07 에서 48초 8충돌, s20~22 실여유 -0.043 m.
#                코리도 한계는 벽-R_car(0.30) 인데 차는 벽-0.155 까지 감
#                = 0.145 m 위반. 그 비용이 20+2·15·0.145 ≈ 24 로 진행이득에
#                밀렸다. 장애물 행의 1/10 이라 벽이 늘 최약 탈출구.
#                존 4개로 트랙 58% 를 덮던 것은 이 약한 기본값의 반창고.
#                ⚠ 2026-06-02 실패(반대편 클립) 재발 여부를 좌/우 접촉을 따로
#                세어 확인할 것. 악화되면 corridor 를 20/15 로 되돌리면 된다.
# ---------------------------------------------------------------------------
# 이 파일만 고치고 mpc_node 를 재시작하면 반영된다 (재빌드 불필요).
# 파일이 없거나 깨지면 코드의 기본값으로 조용히 폴백한다.

slack:
  obstacle:  {zl: 200.0, zu:  40.0, Zl: 700.0, Zu: 30.0}   # 0807 신맵: 심 값으로 통일 (이전 120)
  corridor:  {zl:  60.0, zu:  20.0, Zl: 400.0, Zu: 15.0}   # 0807 신맵: 심 값으로 통일 (이전 20/15 = 존 전제)
  a_lat:     {zl:  50.0, zu:  50.0, Zl:  15.0, Zu: 15.0}
  ellipse:   {zl:  50.0, zu:  50.0, Zl:  15.0, Zu: 15.0}
  obstacle2: {zl: 200.0, zu:  40.0, Zl: 700.0, Zu: 30.0}   # 0807 신맵: 심 값으로 통일
  obstacle3: {zl: 200.0, zu:  40.0, Zl: 700.0, Zu: 30.0}   # 0807 신맵: 심 값으로 통일


# ── 비용 가중치 (codegen 시 W 행렬에 구워짐) ───────────────────────────────
# 실효 가중치 = 여기 값 × ddrx_unified_params.yaml 의 q_*_scale_live.
#   예) q_cte 15.0 × q_cte_scale_live 4.9469 = 74.2
# 잔차 순서: [e_c, e_l, yaw_err, v-ref_v, δ-δ_ff, p_v-target, side, δ-δ_prev, a_x, p_v]
# terminal_* 는 종단 스테이지(W_e)에서 해당 항에 곱하는 배수.
cost_weights:
  q_cte:     15.0     # 횡(contouring) — 라인추종. 9→15
  q_lag:     80.0     # 종(lag) — 진행 정렬. 45→80
  q_psi:     10.0     # yaw 오차
  q_v:       12.0     # 속도 추종 (ref_v)
  q_dd:       5.0     # 조향 - 곡률 피드포워드 편차
  q_p:        1.0     # progress pull. 4→1 (BO 가 scale 로 학습)
  q_side:     3.0     # 장애물 side hint (코드상 side_term=0 이라 현재 미사용)
  q_d_rate:  80.0     # 조향 변화율
  q_dv:      15.0     # 종가속 a_x 벌점
  terminal_cte: 10.0   # 0807 신맵: 심 값으로 통일 (이전 5.0)
                        # 직선끝 코너진입 스윙에서 계획(-0.13)보다 실행(-0.26)이 깊어지는
                        # 리플랜 드리프트 억제 목적 — 끝점을 라인에 더 세게 묶는다.
                        # 나빠지면 5.0 으로 롤백 (커밋 33747e8 = 롤백 지점).
  terminal_lag:  5.0
  terminal_psi:  4.0
  terminal_v:    3.0


# ── 코리도 마진 (런타임 파라미터 → 재시작만으로 반영) ──────────────────────
# 코리도 한계 = 센터라인 벽 − R_car. R_car 를 스테이지 곡률에 비례시킨다:
#
#     R_car(κ) = r_car_straight + (R_car_live − r_car_straight) · min(1, |κ|/kappa_ref)
#
# 근거 (2026-07-29 bag 실측): 차(0.58×0.31)가 벽 법선방향으로 실제 필요한
# 반치수는 직선 p95 0.245 / 헤어핀 p95 0.256 — 곡률 무관하게 0.25 근처.
# 그런데 상수 R_car=0.30 은 직선에서 레이스라인을 코리도 한계 9cm 앞까지
# 몰아넣어(라인이 그 구간에서 벽에 붙음) 솔버가 한계를 피해 물러서는
# "직선인데 S자" 현상을 만들었다. 직선만 0.24 로 풀면 그 모순이 사라진다
# (R_car 0.16 실험에서 직선 전반부 이탈 68% 감소 확인).
# R_car_live(코너 상한)는 ddrx_unified_params.yaml 의 ROS 파라미터 그대로.
corridor:
  r_car_straight: 0.30    # 0729 실험: 0.24 로 넓혀도 직선 이탈 개선 없음(0.179→0.197,
                          # bag 16_53) → 0.30 으로 원복해 사실상 비활성. 직선 S자의 원인은
                          # 코리도 조임이 아니었다. 곡률비례 메커니즘은 남겨둠(값만 중립).
  kappa_ref:      0.5     # 이 곡률 이상이면 R_car_live 풀값 [1/m]


# ── 장애물 제약 상수 (심볼릭 모델에 들어감 → 변경 시 재생성) ───────────────
obstacle:
  # BIG-M 게이트 상수. 게이트가 닫힌(장애물 먼) 스테이지에서 h_obs 를 이 값으로
  # 치환해 제약을 무력화한다. 너무 크면 슬랙이 위반을 공짜로 사버린다 —
  # 50 → 5 로 내린 뒤에야 "간격 0.3~0.45 접촉"이 설명됐다(0722).
  big_m:       5.0
  # 근접 게이트 σ [m]. 2.5 는 commit 거리(6~10 m)에서 게이트≈0.06 이라
  # 회피 시작이 너무 늦었다 → 4.5.
  sigma_gate:  3.5   # 0807 신맵: 심 값으로 통일 (이전 4.5)
  # side_term 근접 σ [m] (side_term 이 꺼져 있어 현재 영향 없음).
  sigma_side:  0.5
  # 장애물 옆에서 q_cte(라인당김)를 얼마나 죽일지. 1.0=완전, 0=안 죽임.
  # 0.95 는 되당길 힘이 없어 복귀가 안 됐다 → 0.70 (30% 남김).
  # 동적(원형) 모드에서는 코드가 감쇠를 적용하지 않는다.
  line_attenuation: 0.70
