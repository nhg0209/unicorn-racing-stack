# ROS2 parameter file — IFAC MPC node.
# Original ROS1 layout (`converter:`, `home_dir:`, etc.) translated to the
# `<node_name>: ros__parameters:` structure rclpy expects. Values are the
# F-track defaults from unicorn-racing-stack/evo_mpcc/params/ddrx_unified_params.yaml.

# ═══════════════ 실제 튜닝 노브 인덱스 (2026-07-09 정리) ═══════════════
# 이 파일의 파라미터 대부분은 레거시/미사용. 실제로 거동을 바꾸는 건 아래뿐:
#  [속도]  progress_reward_gamma(5.0, codegen)  q_p_scale_live(6.5)  q_dv_scale_live(0.15)
#          speed_cmd_gain(1.0=off, 가속오차증폭)  accel_preview_s(1.0)  max_speed_p / speed_target
#  [코너]  q_v_scale_live(2.0)  dyn_mu(0.70, codegen)  brake_anticip_a(7.0=지터필터)
#  [라인]  q_cte_scale_live  R_car_live  track_source
#  [회피]  R_safe_live(0.40)  commit_dist_live(8)  obstacle_hold_s(0.3)
#  [안정]  q_drate_scale_live  slew_up/down_rate  cost_spike_thr_live
#  유령(무효): a_lat_safe_live>6.52는 clamp / (mpc_v_track·vp_project는 삭제됨)
#  codegen 값 바꾸면: rm -rf ~/.acados_codegen/* 후 relaunch
#  (2026-07-16 부로 캐시가 /tmp -> ~/.acados_codegen 로 이동했다. 예전 주석의
#   /tmp 경로로 지우면 아무것도 안 지워지고 옛 솔버를 그대로 쓴다.)
# ══════════════════════════════════════════════════════════════════════
mpc_node:
  ros__parameters:

    # Topics — match unicorn race_stack convention
    odom_topic_name: /car_state/odom
    localized_pose_topic_name: /car_state/pose
    cmd_vel_topic_name: /vesc/high_level/ackermann_cmd   # car stack simple_mux input (matches PP controller)

    # Track loader
    track_name: f                  # → share/tracks/trackf/track f_*.csv
    track_dir: ""                  # empty = use installed share/tracks/
    slew_gate_settle_s: 0.0   # 0807: 심 9.48 구성과 통일 (코너탈출 정착지연 제거)
    vel_scale: 1.0   # 0821: 맥은 위치점프 0회라 상향 가능 (nuc 은 kiss 붕괴로 0.8 유지)
    inflation_factor: 0.0          # 1.2→0.0 (2026-05-26): random track width 2m 에서 1.2 가 boundary 0.96m 안으로 줄여서 effective half = 0.04m → RViz 상 boundary 거의 centerline. 0.0 = raw boundary.
    extend_part: 2                 # loop overlap (extend_part=2 → +50%)

    # MPC sizing / vehicle limits
    # Conservative IFAC-demo baseline. event_stuck CSV 에서 차가 outside
    # over-shoot 후 reverse stuck → 박히기 전에 막아야. 6 → 4 (코너 과속 ↓).
    max_speed: 10.0   # 0821 원복
    max_speed_p: 8.0   # 0821 3단계: 코리도 슬랙 200 복원 후 재상향 (60 시절엔 벽관통했음)
    actuation_latency_s: 0.12   # 0807 발진픽스: 서보 실측 120ms 보상 복원 (0.0은 옛 A/B 잔재. 0.6Hz 리밋사이클 대책, q_drate 60과 세트)
    # R3 decouple test: hard cap=8 (above) but progress target + κ-window stay at
    # the proven 6-regime → cap↑ should be harmless (unlike old coupled max=8).
    speed_target: 10.0   # 0807 신맵 ifac_0807b: 심과 통일 (codegen 구움, 이전 8.0)
    progress_reward_gamma: 5.0   # 2026-07-09 2차: 1.0은 무효(이동 +0.125). 5.0=+0.6m/s 이동. 다음 8
    lookahead_m: 2.0
    brake_anticip_a: 5.0   # 0821: 실측 달성제동 정합   # 0818 bldg: 5.5→4.5 — s18-20 진입 급제동+조향(6.8→3.3 in 2m) 우벽 매랩, 제동 시점 앞당김. 되돌리기 5.5   # 2026-07-16 코너 와이드 대응 7.0->5.5: d_min=1.0이 근거리 제외해줘서 이제 코너 진입만 잡고 직선 톱스피드는 무손실 (0709의 5.5=직선-0.4s는 d_min 이전 근거리 바인딩 때문이었음)
    accel_preview_s: 1.0   # 2026-07-09 가속실험: 0.7->1.0 (실측 지속가속 2.0 — VESC 더 몰아붙임. duty 3x 여유)
    speed_cmd_gain: 1.5   # 검증값 (실가속 1.58->2.17, 랩 9.44). 다음 세션: 2.0 시도
    # 국소 corridor 하드닝 (스텁 s≈21.6): 존 안 slack 벌금 x10 — soft 뚫림 대응 (2026-07-09)
    corridor_hard_s0: 19.5   # 0821 bldg_0821
    # 2026-07-31: 25.5 -> 28.0. 같은 풍선효과가 새 경계에서 재발했다.
    #   bag 13_04 실측: 10랩 중 4랩에서 s25.4~26.0 이탈 0.71~0.92 m (좋은 랩은 0.20).
    #   최악 랩 시계열 — s24 진입에서 a_x -7.00(최대제동) 연속 → v 2.41->1.74,
    #   조향 +0.39 풀락, cost 134->825. 존이 끝나는 s25.5 직후에 정확히 발생.
    #   트랙 곡률: s25 kappa=0.838, s26 0.488, s27 0.279, s28 0.000 <- 진짜 코너 출구.
    #   주석의 원래 의도("코너 탈출까지 연장")를 실제 출구(kappa=0)까지 맞춘다.
    corridor_hard_s1: 25.5   # 0821 bldg_0821
    corridor_hard_factor: 1.0   # 0821 bldg_0821
    corridor_hard_qcte_factor: 1.0   # 0821 bldg_0821
    straight_qv_factor: 2.0   # 2026-07-16 직선 전용 q_v 부스트(|κ|<thr 스테이지만 ×factor). 진단: 고속존 ref-cmd +1.79/cmd-act -0.02 → 명령이 ref 못 쫓음(코너 타협 q_v). 1.0=off
    straight_kappa_thr: 0.15  # 직선 판정 곡률 문턱 [1/m] (코너캡 abs_kappa_lut 공유)
    brake_anticip_d_min: 1.0  # 2026-07-16 anticip 캡 근거리(d<1m) 제외 — 직선 가속목줄 해제(plan6.9→cmd5.8 손실 복구). 0=기존
    speed_cmd_err_max: 2.2  # 2026-07-16 직선 서징 수정: cmd<=실속+1.5 (지터필터+erpm캡 슬래밍 방지, VESC 구동력은 유지). 0=off
    brake_preview_s: 0.4   # 2026-07-16 min-guard 창만 짧게 — 직선 후반 조기제동 해소 (가속 preview 1.0 유지, 원거리 제동은 anticip 담당). 0=기존
    slew_up_rate: 5.0   # 0821 nuc 값 이식 (가속 상승률)
    slew_up_rate_straight: 5.0   # 0818: 4.5→5.0   # 0818 bldg: 4.0→4.5 직선만 (새타이어·μ0.79, 코너 4.0 유지)   # 0813e 동일. 이전 3.0
    slew_down_rate: 5.0   # 0818: 7.0 시도(23:19 런) — 코너 이탈 개선 없음(진입속도 동일, 코너내 과속이 원인) → 기본 5.0 복귀
    corridor_hard2_s0: 7.0   # 0821 실측 벽침범(실벽 0.10~0.11) 구간 하드닝
    corridor_hard2_s1: 9.0   # 0821 실측 벽침범(실벽 0.10~0.11) 구간 하드닝
    corridor_hard2_factor: 2.0   # 0821: 4.0 은 슬랙200 과 겹쳐 멈칫거림(cmd 0 이 24%) — 2.0 으로 완화
    corridor_hard2_qcte_factor: 2.5   # 0821 bldg_0821
    corridor_hard3_s0: 14.0   # 0821 실측 벽침범(실벽 0.10~0.11) 구간 하드닝
    corridor_hard3_s1: 16.0   # 0821 실측 벽침범(실벽 0.10~0.11) 구간 하드닝
    corridor_hard3_factor: 2.0   # 0821: 4.0 은 슬랙200 과 겹쳐 멈칫거림(cmd 0 이 24%) — 2.0 으로 완화
    corridor_hard3_qcte_factor: 1.0   # 0821 bldg_0821
    corridor_hard4_s0: 22.5   # 0821 실측 벽침범(실벽 0.10~0.11) 구간 하드닝
    corridor_hard4_s1: 24.0   # 0821 실측 벽침범(실벽 0.10~0.11) 구간 하드닝
    corridor_hard4_factor: 2.0   # 0821: 4.0 은 슬랙200 과 겹쳐 멈칫거림(cmd 0 이 24%) — 2.0 으로 완화
    corridor_hard4_qcte_factor: 1.0   # 0821 bldg_0821
    corridor_hard5_s0: 25.0   # 0821 bldg_0821
    corridor_hard5_s1: 35.0   # 0821 bldg_0821
    corridor_hard5_factor: 1.0   # 0821 bldg_0821
    corridor_hard5_qcte_factor: 1.0   # 0821 bldg_0821
    corridor_hard6_s0: 8.7   # 0821 bldg_0821
    corridor_hard6_s1: 11.1   # 0821 bldg_0821
    corridor_hard6_factor: 1.0   # 0821 bldg_0821
    corridor_hard6_qcte_factor: 1.0   # 0821 bldg_0821
    qcte_zone_factor: 1.0   # 0819: 존별 qcte factor 로 이관 (이전 2.0). 존별 값이 1.0 일 때의 폴백으로만 남음   # 0818 bldg: 1.0→2.0 존 안 q_cte 부스트(존5 와 세트)   # zone-save 자동 추가
    # 2026-06-11 조향 정직화: sim plant s_max=0.4189 (sim_params.yaml) 인데 0.45
    # 로 계획 → 풀락 헤어핀에서 유령 조향 8% (계획 R 0.68m vs 실제 0.74m) = wide.
    # plant 한계와 일치시킴. 실차는 VESC servo 매핑상 ±한계가 [-0.396, +0.428]
    # (gain -1.2135, offset 0.52, servo 0..1) → 실차 배포 시 0.39 권장.
    mpc_max_steering: 0.4   # 0821: 서보한계 0.4189 초과 명령 제거   # 2026-07-03 실측: δ_cmd>0.40 응답 평탄(δ_eff~0.36 엔드스톱, 그립한계 이하) — 초과명령=서보 갈림(끼익)
    # Cold-start / low-speed conditioning (2026-05-29, MPPI init_vel 기법).
    # cold_start_vx_floor: solver 에 넘기는 x0 의 vx 하한 (dynamic 저속 ill-cond
    #   회피 → 저속 steer chatter 제거 + 정지 출발). 0 = 비활성 (기존 PP-start 동작).
    # startup_speed: 실측 vx 가 floor 미만일 때 출력 speed 하한 (forward push).
    # 이 둘로 기존 3초 PP warmup ramp 대체 → t=0 부터 MPCC 조향.
    cold_start_vx_floor: 2.0
    startup_speed: 3.0
    dT: 0.04                       # 0.025→0.04 (25Hz control rate). multi-dt 와 결합 — 첫 step.
    N_horizon: 40                         # N20=18.4s best. N25/N50 시도(2026-06-08)는 N20-weight라 더 느림(22~25s)·stuck 이동 → 원복. horizon 늘리려면 N에 맞춰 재튜닝(BO) 필요.
    # time_steps_mode: 'uniform' (모든 step dt=dT) 또는 'pyramidal' (multi-dt: 가까이 sharp + 멀리 long planning).
    # pyramidal: dt = [dT]*20 + [dT*1.5]*30 + [dT*2.5]*30
    #   = [0.04]*20 + [0.06]*30 + [0.10]*30 → 0.8 + 1.8 + 3.0 = 5.6s horizon
    #   v=4: 22m, v=7: 39m — 다음 코너 + α 보임 → outside-inside-outside racing line 학습.
    # solve_ms 영향 거의 없음 (N=80 그대로). codegen 처음 한 번 ~30s.


    # Reference path source for mpc:
    #   centerline → /centerline_waypoints (트랙 한가운데, racing line 거동
    #                위해 D_apex bias 필요. PP-like 느낌)
    #   raceline   → /global_waypoints (IQP 사전 최적화된 racing line.
    #                코너에서 자연스럽게 apex 통과, vx_mps 점별 가속/감속.
    #                D_apex 는 0 권장 — raceline 자체가 이미 apex 통과)
    track_source: raceline   # MPCC corridor reference (B-mode가 corridor 내 racing line 자유결정). raceline 모드는 구조적 wedge(미해결).

    # auto_tune=true 이면 max_speed 한 변수만 사용자가 설정하고, 나머지
    # q_lag / q_cte / max_speed_p / alpha_steer / corridor / D_apex /
    # cost_spike_thr 는 _auto_tune_from_max_speed() 의 heuristic 매핑으로
    # 자동 결정. 매핑 공식은 mpc_node.py 의 docstring 참고.
    # 빠르게 튜닝하려면 true, 수동 정밀 튜닝 원하면 false.

    # C: MLP weight scaler. use_ml_scale=true 면 _adaptive_weight_update()
    # 가 B heuristic 대신 NN 추론 사용. 학습된 .pt 없으면 자동 B 폴백.
    # 학습: python3 -m nonlinear_mpc_acados.ml.train --epochs 200
    # ml_model_path "" → 기본 위치 (ml/saved/weight_scaler.pt) 사용.

    # ── Dynamic Pacejka 모드 ──
    # dynamic=True: 8-state, tire slip 모델링 (정확, 느림)
    # dyn_tire_model: 'linear' / 'tanh' / 'pacejka'
    #   linear: F_y = C_α · α (slip 작을 때만 정확)
    #   tanh  : 2026-05-27 review #9. lat_g=24 m/s² 영역에서 linear 한계 → tanh 권장.
    #           코너 진입 시 tire saturation 모델링.
    use_dynamic: true
    # nlp_solver_iters: 1 → SQP_RTI (실시간 안정, 기본). >1 → SQP(max_iter cap)+
    # MERIT_BACKTRACKING globalization. 1-iter RTI 가 저속 dual-active-set 함정에서
    # 못 빠져나오는 문제 탈출용. A/B: 1 vs 2 (sim 에서만 검증 후 차 적용).
    nlp_solver_iters: 1
    dyn_tire_model: tanh
    # 모델 타이어 μ — sim_params.yaml mu(또는 실차 노면)와 일치시킬 것 (2026-06-10 그립 정직화)
    dyn_mu: 0.55   # 0821 nuc이식: 끌기실측 μ0.563   # 0818 bldg: 0.65→0.79 끌기 μs 0.89 −0.1 (새바닥·새타이어)   # 0813b s24-26 슬라이드(가속 중 스냅, 노면 오염 추정) — 알고리즘 대응으로 하향. 이전 0.70 (0812 0.75 는 .bak 참조)   # 0812 새바닥 실측(mu_141538, VESC IMU+축폴백): 횡 p95 좌0.85/우0.93, 종 0.83 — 한계도달 13%라 하한값. 0.85 하한에 마진 두고 0.75. 이전 0.65   # 0811 재적용(주행 흔들림 — 실측 횡 0.65). 실측 0.65는 mu_newvenue 메모 참조. # 2026-07-02 실차 friction-circle 실측: 지속 μ_y 0.65~0.75, 순간피크 0.85~0.97 (bag 14_58_38). 0.75 시도했으나 U커브 조향포화 악화(랩 +0.7s)로 0.70 확정. 코너는 grip-limited가 아니라 steering-limited
    # friction ellipse headroom η (a_lim = μ·g·η). 1.0=물리한계 꽉 채움.
    ellipse_frac: 0.95
    # acados LM regularization for dynamic model (QP conditioning / prediction
    # consistency). 1.0 = previous default. Higher → fewer QP_Failure/MINSTEP.
    lm_dynamic: 3.0

    # Phase D — GP residual learning (offline-trained sparse GP).
    # use_gp_residual=true → setup_MPC 후 ResidualLearningMPC 로 wrap.
    # gp_ckpt_path 비우면 ~/bo_results/gp_residual.pt 자동.
    # 첫 launch 추가 codegen ~30s. import error / 파일 없으면 plain acados fallback.

    # Phase D (closed-form CasADi GP) — INDEPENDENT of use_gp_residual.
    # use_gp_casadi=true → bakes the trained GP posterior mean as a pure
    use_gp_casadi: false   # 0818: launch gp:=true 로만 켠다(기본 OFF, launch 가 이 값을 덮음). GP 배포(홀드아웃 d_r 92%/d_vy 61%/d_vx 99.9%, 새바닥·새타이어·dyn_mu0.79). 이전: false hall_0813 GP 는 구바닥·구타이어 → gp_collect:=true 로 재수집   # 0812 재ON: 벽닿기 원인분석 — 직선 정상편향 −0.65m 완화 목적. GP 는 이 장소 실차학습본이라 재적용 타당 (0811 OFF 사유였던 타장소 문제 소멸). 발진 0.7Hz 는 별개(서보캘리브)   # 0811 재OFF: 구장소 학습본이 새장소서 잘못된 동역학 주입 가능 — 새장소 bag 재학습 후 ON. (0807 복원: max_speed 10 이라 학습영역 복귀. 심 9.48 도 ON (실차 데이터 GP)
    gp_casadi_ckpt: /Users/mini/bo_results/gp_residual_mac_bldg0818.pt   # 0818 (이전 hall0813)    # 0813 hall 2-bag(935, finitediff) 재학습, 홀드아웃 d_r 47%. 롤백: gp_residual_0716strat.pt
    gp_casadi_train_data: /Users/mini/bo_results/res_mac_bldg0818_clean_lap02_15.pt   # 0818 (이전 res_mac_merged) 
    # 2026-07-02 학습 ref_v 주입 (오늘 post-fix 5-run, 74bins, grip-clamped +0.3)
    use_learned_refv: false   # 0807 신맵 ifac_0807b: 학습 npz 가 구맵(ifac) 것 (이전 true)
    learned_refv_path: /Users/mini/unicorn_ws/src/unicorn-racing-stack/stack_master/maps/ifac/learned_refv_0716.npz
    # CasADi expression into the DYNAMICS only (cost/p_sym untouched), no
    # torch/gpytorch/l4acados at runtime. Default OFF.

    # B (VPMPCC simplify): override_mode 는 'off' 고정. BO 는 q_*_scale_live 만
    # 직접 갱신. legacy modes (fixed / bucketed / polynomial) 는 mpc_node.py
    # 에 코드 경로만 남고 yaml 키는 default 로 fallback.

    # 자동 max_speed stepper — 같은 launch 안에서 lap 카운트 기반으로
    # effective v_max 자동 증가. codegen ubu cap (yaml max_speed) 가 절대
    # 상한 — auto_step_end 와 같게 두기. mpc.v_max (cost target) 만 변경.
    #   start → end, +size 마다 laps 바퀴.
    # 2026-05-28 사용자 idea: v 점진 ramp (model mismatch 적응 시간 줌)
