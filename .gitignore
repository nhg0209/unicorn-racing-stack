# This meta-repo carries only orchestration (unicorn.repos, CI, build scripts).
# Component repos are imported by vcstool into the PARENT workspace's src/ as
# siblings (see build scripts) — they are never nested inside this repo.

# colcon build artifacts (should not appear here, but ignore defensively)
build/
install/
log/

# Python
*.pyc
__pycache__/
*.egg
*.egg-info/
dist/

# IDE / local
.idea/
.claude/

# colcon profile markers — generated per build profile by
# setup_conda_on{Laptop,Car}.sh (laptop touches them, car removes them).
# Purely local artifacts; never tracked.
COLCON_IGNORE

# container platform-test transient logs (keep .docker/results.txt + scripts)
.docker/build_*.log
.docker/smoke_*.log
.docker/driver_*.out
.docker/colcon_build.log
# old docker/ dir superseded by .docker/ (kept on disk only while a build runs)
/docker/

# rosbag recordings (local debugging only; keep the folder, ignore contents)
/bags/*
!/bags/.gitkeep

# Point-cloud maps: the 3D localization voxel map (localization.launch.xml passes
# map_pcd_3d = <map>.pcd, REQUIRED when kiss.yaml input_mode is "3d"). ifac_0807.pcd is 117 MB,
# past GitHub's hard 100 MB blob limit, so it cannot live in this repo as a plain object -- the
# push is rejected by a pre-receive hook, not merely discouraged. It was carried in history from
# cf01400 until 2026-08-11 and has been stripped from those 28 commits (backup tag:
# backup/pre-pcd-strip-0811). The file stays on disk and on the car; a fresh clone that needs the
# Livox 3D path has to obtain it out of band, or regenerate it from a mapping run. If it should be
# versioned instead, that is Git LFS and a deliberate decision -- it costs 12 % of the free quota
# and makes git-lfs a clone requirement for everyone.
*.pcd
