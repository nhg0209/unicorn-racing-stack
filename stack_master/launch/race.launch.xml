<?xml version="1.0"?>
<!--
  race.launch.xml  —  NUC (real car, KISS-ICP localization)
  ==============================================================================
  Local stack, unchanged features (reopt / closed_qp / static+dynamic avoidance /
  GP prediction / L1 controller), with real-car defaults.

  Difference from the old NUC file: the kiss obstacle front-end.
    old NUC : perception/kiss_obstacle_adapter.py  <- /kiss_loc/obstacle_poses (PoseArray)
    this    : perception/kiss_obstacle_bridge      <- /kiss_loc/detections     (MarkerArray CUBE)
  Only kiss_obstacle_bridge exists in this stack (perception/scripts/). Its input topic
  is the `kiss_marker_topic` arg below — point it wherever this car's kiss build publishes.

  REAL: ros2 launch stack_master race.launch.xml map:=ifac_0807
  SIM : ros2 launch stack_master race.launch.xml map:=ifac_0807 sim:=true
-->
<launch>
  <arg name="map"        description="Map name (folder in stack_master/maps/)"/>
  <arg name="sim"        default="false" description="Use simulator (true) or real hardware (false)"/>
  <arg name="localization" default="kiss" description="Real-car localization: cartographer | pf | kiss (ignored in sim, which uses gym ground truth)"/>
  <arg name="detection_source" default="kiss" description="Obstacle detection front-end: kiss (Livox 3D BevDetector -> kiss_obstacle_bridge) | scan (2D perception/detect on /scan)"/>
  <arg name="kiss_marker_topic" default="/kiss_loc/detections"
       description="MarkerArray (CUBE, map frame) the kiss BEV detector publishes. Change if this car's kiss build uses another name; the bridge reads it and emits /detect/raw_obstacles"/>
  <arg name="virtual"    default="$(var sim)" description="Inject a virtual opponent + static obstacles (on in sim, off on the real car; virtual:=true overlays a virtual opponent onto the real LiDAR)"/>
  <arg name="opp_spawn"  default="false" description="(virtual) spawn the kinematic opponent at startup on the map centerline"/>
  <arg name="opp_mode"   default="manual" description="(virtual) opponent driving mode: manual | path | ftg"/>
  <arg name="ot_planner" default="predictive_spliner" description="overtake planner the state machine listens to (listens to BOTH /planner/avoidance/otwpnts and /planner/avoidance/static_otwpnts)"/>
  <arg name="control_topic" default="/local_waypoints"
       description="WpntArray the controller follows: /local_waypoints (state-machine output w/ avoidance) or /global_waypoints (robust raceline)"/>
  <arg name="use_pp_heading" default="false"
       description="Run pp_heading_controller instead of controller_manager (only one runs)"/>
  <arg name="use_hokuyo" default="false" description="(real) start the Hokuyo urg_node (/scan). OFF: this car runs the Livox MID-360; without /scan the FTG fallback + estop are inert"/>
  <arg name="use_livox"  default="true"  description="(real) start the Livox MID-360 driver (/livox/lidar + /livox/imu for kiss 3D localization + detection)"/>
  <arg name="rviz"       default="false" description="(real) also start RViz with the pitwall config (2D Pose Estimate seeds kiss via /initialpose)"/>
  <arg name="reopt"      default="true"  description="Obstacle-aware global line (closed_qp static re-optimization): static_reopt_node + static_obstacle_layer instead of plain global_trajectory_publisher. Needs maps/&lt;map&gt;/centerline.csv"/>
  <!-- sim has no Livox -> force the 2D 'scan' path there; the real car honours detection_source. -->
  <let name="det_src" value="scan" if="$(var sim)"/>
  <let name="det_src" value="$(var detection_source)" unless="$(var sim)"/>
  <!-- sim -> SIM config (racecar_f110.ini + veh_dyn_info); real hardware -> CAR. Folder name == racecar_version. -->
  <let name="racecar_version" value="SIM" if="$(var sim)"/>
  <let name="racecar_version" value="CAR" unless="$(var sim)"/>

  <!-- ===== Base system: sensors + localization + raceline (+ reopt) + frenet odom ===== -->
  <include file="$(find-pkg-share stack_master)/launch/base_system.launch.xml">
    <arg name="map"          value="$(var map)"/>
    <arg name="sim"          value="$(var sim)"/>
    <arg name="localization" value="$(var localization)"/>
    <arg name="virtual"      value="$(var virtual)"/>
    <arg name="opp_spawn"    value="$(var opp_spawn)"/>
    <arg name="opp_mode"     value="$(var opp_mode)"/>
    <arg name="reopt"        value="$(var reopt)"/>
    <arg name="use_hokuyo"   value="$(var use_hokuyo)"/>
    <arg name="use_livox"    value="$(var use_livox)"/>
  </include>

  <!-- Optional on-car RViz. 2D Pose Estimate publishes /initialpose, which seeds kiss. -->
  <group unless="$(var sim)">
    <node pkg="rviz2" exec="rviz2" name="rviz" output="log" if="$(var rviz)"
          args="-d $(find-pkg-share stack_master)/config/pitwall.rviz"/>
  </group>

  <!-- ===== Perception ===== -->
  <!-- detection_source=scan: 2D perception/detect on /scan (Hokuyo, or Livox via pointcloud_to_laserscan) -->
  <group if="$(eval '\'$(var det_src)\' == \'scan\'')">
    <node pkg="perception" exec="detect" name="detect" output="screen">
      <param from="$(find-pkg-share stack_master)/config/opponent_tracker_params.yaml"/>
      <param name="map" value="$(var map)"/>
    </node>
  </group>

  <!-- detection_source=kiss: kiss BEV detector (detect_en:true in kiss.yaml) publishes CUBE
       markers; the bridge converts them to Frenet-filled /detect/raw_obstacles.
       Requires localization:=kiss and maps/<map>/<map>_track.yaml + <map>_ground_lidar.yaml. -->
  <group if="$(eval '\'$(var det_src)\' == \'kiss\'')">
    <node pkg="perception" exec="kiss_obstacle_bridge" name="kiss_obstacle_bridge" output="screen">
      <param name="marker_topic" value="$(var kiss_marker_topic)"/>
    </node>
  </group>

  <!-- with virtual:=true tracking_merger owns /tracking/obstacles -->
  <let name="tracking_out" value="/tracking/obstacles_raw" if="$(var virtual)"/>
  <let name="tracking_out" value="/tracking/obstacles"     unless="$(var virtual)"/>
  <node pkg="perception" exec="tracking_node" name="tracking" output="screen">
    <param from="$(find-pkg-share stack_master)/config/opponent_tracker_params.yaml"/>
    <remap from="/tracking/obstacles" to="$(var tracking_out)"/>
  </node>

  <!-- ===== State machine ===== -->
  <node pkg="state_machine" exec="state_machine" name="state_machine" output="screen">
    <param from="$(find-pkg-share stack_master)/config/state_machine_params.yaml"/>
    <param name="sim"             value="$(var sim)"/>
    <param name="racecar_version" value="$(var racecar_version)"/>
    <param name="timetrials_only" value="false"/>
    <param name="ot_planner"      value="$(var ot_planner)"/>
    <param name="map"             value="$(var map)"/>
  </node>

  <!-- Recovery planner -> /planner/recovery/wpnts -->
  <node pkg="recovery_spliner" exec="recovery_spliner_node" name="recovery_spliner_node" output="screen"/>

  <!-- Start planner -> /planner/start_wpnts -->
  <node pkg="spliner" exec="start_spline_node_v2" name="start_planner" output="screen"/>

  <!-- Static avoidance (Frenet grid-sampling) -> /planner/avoidance/static_otwpnts
       + /planner/avoidance/static_feasible (Bool) <- /planner/avoidance/relax (Bool).
       Both Bools are planner interlocks, deliberately NOT remapped. -->
  <node pkg="spliner" exec="static_avoidance_node" name="static_avoidance_planner" output="screen">
    <param from="$(find-pkg-share stack_master)/config/static_avoidance_params.yaml"/>
    <remap from="/planner/avoidance/otwpnts" to="/planner/avoidance/static_otwpnts"/>
  </node>

  <!-- Dynamic avoidance (lane-hold overtake) -> /planner/avoidance/otwpnts + /planner/avoidance/merger -->
  <node pkg="lane_change_planner" exec="change_avoidance_node" name="planner_change" output="screen">
    <param from="$(find-pkg-share stack_master)/config/lane_change_params.yaml"/>
  </node>
  <node pkg="lane_change_planner" exec="update_waypoints" name="waypoint_updater" output="screen"/>

  <!-- ===== GP opponent-trajectory predictor ===== -->
  <node pkg="gp_traj_predictor" exec="opponent_trajectory"       name="OpponentHalflap"                output="screen"/>
  <node pkg="gp_traj_predictor" exec="gaussian_process_opp_traj" name="GP_trajectory"                  output="screen" launch-prefix="taskset -c 1"/>
  <node pkg="gp_traj_predictor" exec="opp_prediction"           name="opponent_propagation_predictor" output="screen"/>

  <!-- ===== Control: L1 / Pure-Pursuit ===== -->
  <node pkg="controller" exec="controller_manager" name="controller_manager" output="screen"
        unless="$(var use_pp_heading)">
    <param from="$(find-pkg-share stack_master)/config/controller.yaml"/>
    <param name="save_yaml_path" value="$(find-pkg-share stack_master)/config/controller.yaml"/>
    <param name="sim" value="$(var sim)"/>
    <!-- picks config/<SIM|CAR>/veh_dyn_info/ggv.csv for the steering tyre limit -->
    <param name="racecar_version" value="$(var racecar_version)"/>
  </node>

  <node pkg="controller" exec="pp_heading_controller" name="pp_heading_controller" output="screen"
        if="$(var use_pp_heading)">
    <param from="$(find-pkg-share controller)/config/pp_heading_params.yaml"/>
    <remap from="/local_waypoints" to="$(var control_topic)"/>
  </node>
</launch>