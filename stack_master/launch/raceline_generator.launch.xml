<?xml version="1.0"?>
<!--
  raceline_generator.launch.xml — build the global raceline from an EXISTING map.

  This is the old mapping.launch.xml "create_map:=false create_global_path:=true"
  path, split out as its own launch: it does NOT drive the car or run SLAM. Run it
  after mapping.launch.xml has produced stack_master/maps/<map>/<map>.{png,yaml}.

  It serves the saved map, runs the gb_optimizer global planner to produce
  global_waypoints.json, then slices the speed / overtaking sectors
  (speed_scaling.yaml / ot_sectors.yaml).

    ros2 launch stack_master raceline_generator.launch.xml map:=map_test
-->
<launch>
  <arg name="map"                                  description="Map name (folder in stack_master/maps/)"/>
  <arg name="sim"                default="false"   description="Pick SIM vs CAR racecar_version/config"/>
  <arg name="gb_conf_path"       default="$(find-pkg-share stack_master)/config/global_planner_params.yaml"
       description="ROS params YAML for the global planner node"/>
  <arg name="reverse"            default="false"   description="Reverse raceline direction"/>
  <arg name="show_plots"         default="false"   description="Show optimization result plots"/>
  <arg name="rebound"         default="true"    description="After the line is optimized, re-measure d_left/d_right against the untouched wall image. The optimizer measures them on [map].png, which is also the image people edit to force the line where they want it, so a corridor narrowed in GIMP is published as the real one. Truth image is [map]_origin.png when present, else [map].pgm. See scripts/rebound_widths.py."/>
  <arg name="rebound_timeout" default="900.0"   description="Seconds to wait for the optimizer to finish writing global_waypoints.json before giving up on the re-measure"/>
  <arg name="slice_gui"          default="false"    description="Open the matplotlib sector-slicing GUI. false = headless: write ONE sector over the whole track and exit. The GUI blocks forever with no display, so use false over SSH."/>

  <!-- sim -> SIM config folder, real hardware -> CAR config folder. The folder
       name doubles as racecar_version (holds racecar_f110.ini + veh_dyn_info/). -->
  <let name="racecar_version" value="SIM" if="$(var sim)"/>
  <let name="racecar_version" value="CAR" unless="$(var sim)"/>
  <let name="maps_dir" value="$(env STACK_MASTER_MAPS_ROOT $(find-pkg-share stack_master)/maps)"/>

  <!-- ===== global planner (gb_optimizer): plan from the existing map ===== -->
  <!-- emulate_tty: line-buffer the node's stdout so the optimizer's plain
       print()s (IQP iterations etc.) stream live instead of dumping at exit. -->
  <node pkg="gb_optimizer" exec="global_planner_node" name="global_planner" output="screen" emulate_tty="true">
    <param from="$(var gb_conf_path)"/>
    <param name="racecar_version"    value="$(var racecar_version)"/>
    <param name="create_map"         value="false"/>
    <param name="create_global_path" value="true"/>
    <param name="map"                value="$(var map)"/>
    <param name="map_dir"            value="$(var maps_dir)/$(var map)/"/>
    <param name="reverse_mapping"    value="$(var reverse)"/>
    <param name="show_plots"         value="$(var show_plots)"/>
  </node>

  <!-- ===== map source: serve the already-saved map so the planner can read it ===== -->
  <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
    <param name="yaml_filename" value="$(var maps_dir)/$(var map)/$(var map).yaml"/>
  </node>
  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager" output="screen">
    <param name="autostart"  value="true"/>
    <param name="node_names" value="[map_server]"/>
  </node>

  <!-- ===== sector slicing (speed_scaling.yaml / ot_sectors.yaml) ===== -->
  <!-- Each subscribes to /global_waypoints (+ /trackbounds, /shortest_path) from
       the global planner above and writes its sector yaml into the map folder. -->
  <node pkg="sector_tuner" exec="sector_slicer" name="sector_node" output="screen">
    <param name="save_dir" value="$(var maps_dir)/$(var map)"/>
    <param name="use_gui" value="$(var slice_gui)"/>
  </node>
  <node pkg="overtaking_sector_tuner" exec="ot_sector_slicer" name="ot_sector_node" output="screen">
    <param name="save_dir" value="$(var maps_dir)/$(var map)"/>
    <param name="use_gui" value="$(var slice_gui)"/>
  </node>

  <!-- ===== track bounds: re-measure on the true wall, after the line is written ===== -->
  <!-- The planner node above does not exit once it has written global_waypoints.json, it
       keeps publishing, so there is no process exit to trigger on. The script waits for both
       written files to appear with a fresh mtime and then hold still, and only then rewrites
       the widths; x/y are never touched, so the optimized line is exactly as produced.
       It refuses to write unless it can first reproduce the stored widths on the image that
       generated them, so a drift between it and the planner stops it instead of corrupting
       the map. optional keeps a map with no truth image from failing the launch. -->
  <executable cmd="$(find-pkg-prefix stack_master)/lib/stack_master/rebound_widths.py $(var maps_dir)/$(var map) --apply --optional --wait $(var rebound_timeout)"
              name="rebound_widths" output="screen" if="$(var rebound)"/>
</launch>
